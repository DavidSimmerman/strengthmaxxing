<?xml version="1.0" encoding="UTF-8"?>
<!--
  Entitlements for the watchOS "Watch App" target.
  Enable HealthKit capability in Xcode for this target; that adds the healthkit key.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.healthkit</key>
    <true/>
    <key>com.apple.developer.healthkit.access</key>
    <array/>
    <!-- Optional shared App Group (must match iOS target + AppSettings suiteName).
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.tech.simmerman.strengthmaxxing</string>
    </array>
    -->
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info-Watch.plist — watchOS "Watch App" target.

  As with iOS, these keys are the ones that MUST be present. Add them via the target's
  Info tab if you use a generated Info.plist, and enable the matching capabilities under
  Signing & Capabilities.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- CoreMotion device-motion (userAcceleration) for automatic rep counting. -->
    <key>NSMotionUsageDescription</key>
    <string>StrengthMaxxing uses motion to automatically count your reps during a set.</string>

    <!-- HealthKit usage descriptions. -->
    <key>NSHealthShareUsageDescription</key>
    <string>StrengthMaxxing reads heart rate and energy during your workout.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>StrengthMaxxing saves your strength workout to Apple Health.</string>

    <!-- Background modes: keep the live HKWorkoutSession running with the wrist down. -->
    <key>WKBackgroundModes</key>
    <array>
        <string>workout-processing</string>
    </array>

    <!-- Required so the watch app can run its own scene / be a standalone-capable app. -->
    <key>WKApplication</key>
    <true/>

    <!-- Allow local networking for a dev server (direct-to-API watch model). -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>

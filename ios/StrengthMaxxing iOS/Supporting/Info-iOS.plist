<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info-iOS.plist — iPhone app target.

  In modern Xcode projects most Info.plist keys are set in the target's "Info" tab or via
  build settings (GENERATE_INFOPLIST_FILE = YES). The keys BELOW are the ones you MUST add
  because they gate HealthKit + Background Modes. If you use a generated Info.plist, add the
  usage strings under Target ▸ Info ▸ Custom iOS Target Properties and enable the background
  modes / HealthKit capability under Signing & Capabilities.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- HealthKit usage descriptions (required or the app crashes on authorization). -->
    <key>NSHealthShareUsageDescription</key>
    <string>StrengthMaxxing reads your workout, heart rate, and energy data to summarize your training.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>StrengthMaxxing saves your completed strength workouts to Apple Health so they appear in Fitness and close your rings.</string>

    <!-- Background modes: HealthKit background delivery + workout processing. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>workout-processing</string>
    </array>

    <!-- Allow HTTP to a local/dev server. Remove or scope this once you serve over HTTPS. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <!-- For a plain-HTTP remote dev server, add its host under NSExceptionDomains
             instead of NSAllowsArbitraryLoads. Example:
        <key>NSExceptionDomains</key>
        <dict>
            <key>your-server.example.com</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
        -->
    </dict>
</dict>
</plist>

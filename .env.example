# strengthmaxxing — environment (copy to .env and fill in)
# Used by deploy/docker-compose.yml. In Coolify, set these as env vars / secrets.

# --- web (SvelteKit dashboard + JSON API) ---

# Bearer token gating all /api/* routes. When set, clients must send
# `Authorization: Bearer <API_TOKEN>`. Leave UNSET only for open local dev.
# Generate one, e.g.:  openssl rand -hex 32
API_TOKEN=

# Password for signing in to the dashboard (browser). Falls back to API_TOKEN if blank.
DASHBOARD_PASSWORD=

# Public URL of the dashboard. Required when serving the built app over plain http
# (e.g. testing on your LAN), otherwise form posts get "Cross-site POST" 403s.
# Behind Coolify's https proxy it can stay blank.
# ORIGIN=https://strengthmaxxing.simmerman.tech

# Watch motion recordings are up to a few MB.
BODY_SIZE_LIMIT=4M

# Dashboard dates render in this zone.
TZ=America/New_York

# SQLite database file path. Point this INSIDE the mounted volume so data
# persists across redeploys (compose mounts the smx-data volume at /data).
DB_PATH=/data/strengthmaxxing.db

# URL of the coach agent service. Over the compose network the service DNS name
# is `agent`; keep this default unless you run the agent elsewhere.
AGENT_URL=http://agent:8787

# --- agent (Claude coach service) ---

# OPTIONAL. Auth for the coach. Two options:
#   A) Mount your ~/.claude creds into the agent container (see compose) to use
#      the personal Claude subscription via the `claude` CLI — leave this blank.
#   B) Set an Anthropic API key here as a fallback.
ANTHROPIC_API_KEY=

# OPTIONAL. Override the model the coach agent uses (default claude-opus-5-5;
# claude-sonnet-5-5 is faster and cheaper).
AGENT_MODEL=
